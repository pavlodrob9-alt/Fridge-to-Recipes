            </aside>

            <section class="lg:col-span-8 space-y-6">
                <div id="error" class="hidden p-4 rounded-2xl bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-600 dark:text-red-400 text-sm font-medium"></div>

                <div id="loader" class="hidden flex flex-col items-center justify-center py-20 text-center">
                    <div class="relative w-20 h-20 mb-6">
                        <div class="absolute inset-0 border-4 border-amber-500/20 rounded-full"></div>
                        <div class="absolute inset-0 border-4 border-amber-500 rounded-full border-t-transparent animate-spin"></div>
                        <div class="absolute inset-0 flex items-center justify-center text-3xl">👨‍🍳</div>
                    </div>
                    <h3 class="text-xl font-bold mb-2">Curating Gourmet Recipes...</h3>
                    <p class="text-slate-500 dark:text-slate-400 max-w-xs mx-auto">Our AI is analyzing flavor profiles and optimizing your pantry.</p>
                </div>

                <div id="results" class="grid grid-cols-1 gap-6">
                    <div class="flex flex-col items-center justify-center py-20 text-center opacity-50">
                        <span class="text-6xl mb-4">🍽️</span>
                        <h3 class="text-xl font-medium">Ready for your first masterpiece?</h3>
                        <p class="text-slate-500 dark:text-slate-400">Configure your preferences and let the AI work its magic.</p>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <div id="cookingModal" class="hidden fixed inset-0 z-[60] bg-slate-900/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-white dark:bg-slate-800 w-full max-w-2xl rounded-3xl shadow-2xl max-h-[90vh] overflow-hidden flex flex-col">
            <div class="p-6 border-b border-slate-100 dark:border-slate-700 flex justify-between items-center">
                <h2 id="cookingTitle" class="text-2xl font-bold">Cooking Mode</h2>
                <button onclick="closeCookingMode()" class="p-2 rounded-full hover:bg-slate-100 dark:hover:bg-slate-700">✕</button>
            </div>
            <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
                <div class="mb-6">
                    <div class="flex justify-between text-xs font-bold uppercase mb-2">
                        <span>Progress</span>
                        <span id="cookingProgressText">0%</span>
                    </div>
                    <div class="w-full bg-slate-100 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
                        <div id="cookingProgressBar" class="bg-amber-500 h-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>
                <div id="cookingSteps" class="space-y-4"></div>
            </div>
        </div>
    </div>

    <script>
        const form = document.getElementById('recipeForm');
        const resultsDiv = document.getElementById('results');
        const loader = document.getElementById('loader');
        const errorDiv = document.getElementById('error');
        const submitBtn = document.getElementById('submitBtn');
        const maxTimeInput = document.getElementById('maxTime');
        const timeValueDisplay = document.getElementById('timeValue');
        const themeToggle = document.getElementById('themeToggle');
        const themeIcon = document.getElementById('themeIcon');

        const QUICK_INGREDIENTS = ["🥚 Eggs", "🥛 Milk", "🧈 Butter", "🌾 Flour", "🍅 Tomatoes", "🍗 Chicken", "🧀 Cheese", "🧄 Garlic", "🧅 Onion", "🥔 Potatoes", "🥦 Broccoli", "🥑 Avocado"];
        const DIETARY_OPTIONS = ["Vegan", "Gluten-Free", "Keto", "Vegetarian", "Dairy-Free", "Low-Carb"];

        let currentRecipes = [];

        function updateTheme() {
            const isDark = document.documentElement.classList.contains('dark');
            themeIcon.textContent = isDark ? '☀️' : '🌙';
            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        }

        themeToggle.onclick = () => {
            document.documentElement.classList.toggle('dark');
            updateTheme();
        };

        if (localStorage.getItem('theme') === 'dark' || (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        }
        updateTheme();

        function initChips() {
            const ingContainer = document.getElementById('ingredientChips');
            QUICK_INGREDIENTS.forEach(ing => {
                const chip = document.createElement('div');
                chip.className = 'chip px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700';
                chip.textContent = ing;
                chip.onclick = () => toggleIngredient(chip, ing);
                ingContainer.appendChild(chip);
            });

            const dietContainer = document.getElementById('dietaryChips');
            DIETARY_OPTIONS.forEach(diet => {
                const chip = document.createElement('div');
                chip.className = 'diet-chip px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700';
                chip.textContent = diet;
                chip.onclick = () => toggleDietaryChip(chip);
                dietContainer.appendChild(chip);
            });
        }

        function toggleDietaryChip(chip) { chip.classList.toggle('active'); }

        function toggleIngredient(chip, ingredient) {
            const isActive = chip.classList.toggle('bg-amber-500');
            chip.classList.toggle('text-white');
            chip.classList.toggle('border-amber-500');
            const area = document.getElementById('ingredients');
            const cleanIng = ingredient.replace(/[^a-zA-Z ]/g, "").trim();
            let current = area.value.split(',').map(s => s.trim()).filter(Boolean);
            if (isActive) {
                if (!current.includes(cleanIng)) current.push(cleanIng);
            } else {
                current = current.filter(i => i !== cleanIng);
            }
            area.value = current.join(', ');
        }

        maxTimeInput.oninput = (e) => { timeValueDisplay.textContent = e.target.value + 'm'; };

        form.onsubmit = async (e) => {
            e.preventDefault();
            resultsDiv.innerHTML = '';
            errorDiv.classList.add('hidden');
            loader.classList.remove('hidden');
            submitBtn.disabled = true;

            const activeDiets = Array.from(document.querySelectorAll('#dietaryChips .diet-chip.active')).map(c => c.textContent);

            const formData = {
                ingredients: document.getElementById('ingredients').value,
                mealType: document.getElementById('mealType').value,
                cuisine: document.getElementById('cuisine').value,
                dietary: activeDiets, // Sent as array
                maxTime: maxTimeInput.value,
                servings: document.getElementById('servings').value,
            };

            try {
                const response = await fetch('/api/generate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData),
                });

                const data = await response.json();

                if (data.success && Array.isArray(data.recipes)) {
                    currentRecipes = data.recipes;
                    renderRecipes(currentRecipes);
                } else {
                    // This is now a safety fallback since server.js always returns success: true
                    throw new Error('Unexpected server response format.');
                }
            } catch (err) {
                errorDiv.textContent = '❌ ' + err.message;
                errorDiv.classList.remove('hidden');
            } finally {
                loader.classList.add('hidden');
                submitBtn.disabled = false;
            }
        };

        function renderRecipes(recipes) {
            if (!recipes || recipes.length === 0) {
                resultsDiv.innerHTML = '<div class="text-center py-20 opacity-50"><p>No recipes found.</p></div>';
                return;
            }

            recipes.forEach((recipe, index) => {
                const availableCount = recipe.ingredients.filter(i => i.available).length;
                const totalCount = recipe.ingredients.length;
                const matchPercent = Math.round((availableCount / totalCount) * 100);

                const card = document.createElement('div');
                card.className = 'recipe-card glass p-6 rounded-3xl shadow-sm border border-slate-200 dark:border-slate-800 relative group hover:shadow-xl transition-all';

                card.innerHTML = `
                    <div class="absolute top-6 right-6 px-3 py-1 rounded-full bg-amber-500 text-white text-xs font-extrabold shadow-sm">
                        ${matchPercent}% Match
                    </div>
                    <h2 class="text-2xl font-bold mb-4 pr-24 text-slate-900 dark:text-white">${recipe.title || 'Untitled Recipe'}</h2>
                    <div class="flex flex-wrap gap-3 mb-6">
                        <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-medium text-slate-600 dark:text-slate-400">
                            <span>⏱️</span> ${recipe.cook_time || 'N/A'}
                        </div>
                        <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-medium text-slate-600 dark:text-slate-400">
                            <span>📊</span> ${recipe.nutrition?.calories || 'N/A'}
                        </div>
                        <div class="flex items-center gap-1.5 px-3 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 text-xs font-medium text-slate-600 dark:text-slate-400">
                            <span>🌟</span> ${recipe.difficulty || 'Medium'}
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div class="space-y-3">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Ingredients</h3>
                            <ul class="space-y-2">
                                ${recipe.ingredients.map(ing => `
                                    <li class="flex justify-between items-center text-sm p-2 rounded-lg bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700">
                                        <span>${ing.text}</span>
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded ${ing.available ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400' : 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400'}">
                                            ${ing.available ? '✓ HAVE' : '⚠ NEED'}
                                        </span>
                                    </li>
                                `).join('')}
                            </ul>
                        </div>
                        <div class="space-y-3">
                            <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Instructions</h3>
                            <ol class="space-y-3 text-sm text-slate-600 dark:text-slate-400">
                                ${recipe.instructions.map((step, i) => `
                                    <li class="flex gap-3">
                                        <span class="font-bold text-amber-500">${i+1}.</span>
                                        <span>${step}</span>
                                    </li>
                                `).join('')}
                            </ol>
                        </div>
                    </div>
                    <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-800 flex flex-wrap gap-3 justify-between items-center">
                        <button onclick="startCookingMode(${index})"
                            class="px-6 py-2 rounded-xl bg-amber-500 text-white font-bold hover:bg-amber-600 transition-all flex items-center gap-2 shadow-sm">
                            <span>🔥</span> Start Cooking Mode
                        </button>
                        <div class="flex gap-2">
                            <button onclick="copyRecipe(${index})"
                            class="px-4 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-bold hover:bg-slate-50 dark:hover:bg-slate-700 transition-all flex items-center gap-2">
                                <span>📋</span> Copy
                            </button>
                            <button onclick="printRecipe(${index})"
                            class="px-4 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-bold hover:bg-slate-50 dark:hover:bg-slate-700 transition-all flex items-center gap-2">
                                <span>🖨️</span> Print
                            </button>
                            <button onclick="saveRecipe('${recipe.title}', ${index}, this)"
                                class="px-6 py-2 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-sm font-bold hover:bg-slate-50 dark:hover:bg-slate-700 transition-all flex items-center gap-2">
                                <span>❤️</span> Save
                            </button>
                        </div>
                    </div>
                `;
                resultsDiv.appendChild(card);
            });
        }

        function copyRecipe(index) {
            const recipe = currentRecipes[index];
            const text = `${recipe.title}\n⏱️ Time: ${recipe.cook_time}\n🌟 Difficulty: ${recipe.difficulty}\n📊 Calories: ${recipe.nutrition?.calories}\n\nIngredients:\n${recipe.ingredients.map(i => `- ${i.text}`).join('\n')}\n\nInstructions:\n${recipe.instructions.map((s, i) => `${i+1}. ${s}`).join('\n')}`.trim();
            navigator.clipboard.writeText(text).then(() => alert('Recipe copied to clipboard!'));
        }

        function printRecipe(index) {
            const recipe = currentRecipes[index];
            const printWindow = window.open('', '_blank');
            printWindow.document.write(`<html><head><title>${recipe.title}</title><style>body { font-family: sans-serif; padding: 40px; line-height: 1.6; } h1 { color: #0f172a; border-bottom: 3px solid #f59e0b; padding-bottom: 10px; } .meta { color: #64748b; margin-bottom: 20px; } .section-title { font-weight: bold; text-transform: uppercase; color: #0f172a; } ul { list-style: none; padding: 0; } li { margin-bottom: 5px; }</style></head><body><h1>${recipe.title}</h1><div class="meta">⏱️ ${recipe.cook_time} | 🌟 ${recipe.difficulty} | 📊 ${recipe.nutrition?.calories}</div><div class="section"><div class="section-title">Ingredients</div><ul>${recipe.ingredients.map(i => `<li>${i.text}</li>`).join('')}</ul></div><div class="section"><div class="section-title">Instructions</div><ol>${recipe.instructions.map(s => `<li>${s}</li>`).join('')}</ol></div></body></html>`);
            printWindow.document.close();
            printWindow.print();
        }

        function startCookingMode(index) {
            const recipe = currentRecipes[index];
            document.getElementById('cookingTitle').textContent = recipe.title;
            const stepsContainer = document.getElementById('cookingSteps');
            stepsContainer.innerHTML = '';
            recipe.instructions.forEach((step, i) => {
                const stepDiv = document.createElement('div');
                stepDiv.className = 'p-4 rounded-2xl border border-slate-100 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50 flex gap-4 items-start transition-all';
                const timeMatch = step.match(/(\d+)\s*(min|minute)s?/i);
                const timerHtml = timeMatch ? `<button onclick="startStepTimer(this, ${timeMatch[1]})" class="mt-2 px-3 py-1 text-xs font-bold rounded-lg bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 hover:bg-amber-200 transition-all">⏱️ Start ${timeMatch[1]}m Timer</button>` : '';
                stepDiv.innerHTML = `<input type="checkbox" onchange="updateCookingProgress()" class="mt-1 w-5 h-5 rounded border-slate-300 text-amber-500 focus:ring-amber-500 cursor-pointer"><div class="flex-1"><p class="text-slate-800 dark:text-slate-200 font-medium">${step}</p>${timerHtml}</div>`;
                stepsContainer.appendChild(stepDiv);
            });
            document.getElementById('cookingModal').classList.remove('hidden');
        }

        function updateCookingProgress() {
            const checkboxes = document.querySelectorAll('#cookingSteps input[type="checkbox"]');
            const checked = Array.from(checkboxes).filter(c => c.checked).length;
            const percent = Math.round((checked / checkboxes.length) * 100);
            document.getElementById('cookingProgressBar').style.width = `${percent}%`;
            document.getElementById('cookingProgressText').textContent = `${percent}%`;
        }

        function startStepTimer(btn, minutes) {
            let seconds = minutes * 60;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            const timer = setInterval(() => {
                const m = Math.floor(seconds / 60);
                const s = seconds % 60;
                btn.innerHTML = `⏱️ ${m}:${s < 10 ? '0' : ''}${s}`;
                seconds--;
                if (seconds < 0) {
                    clearInterval(timer);
                    btn.innerHTML = '🔔 DONE!';
                    btn.classList.add('bg-green-500', 'text-white');
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        btn.disabled = false;
                        btn.classList.remove('bg-green-500', 'text-white');
                    }, 5000);
                }
            }, 1000);
        }

        function closeCookingMode() { document.getElementById('cookingModal').classList.add('hidden'); }

        function saveRecipe(title, index, btn) {
            const favorites = JSON.parse(localStorage.getItem('culinary_favorites') || '[]');
            if (favorites.some(f => f.title === title)) { alert('Recipe already in favorites!'); return; }
            favorites.push({ title: title, date: new Date().toISOString() });
            localStorage.setItem('culinary_favorites', JSON.stringify(favorites));
            btn.innerHTML = '<span>❤️</span> Saved!';
            btn.classList.add('text-green-600', 'border-green-600', 'bg-green-50', 'dark:bg-green-900/20');
            btn.disabled = true;
        }

        initChips();
    </script>
</body>
